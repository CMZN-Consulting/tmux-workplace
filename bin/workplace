#!/usr/bin/env bash
if [[ -n ${LC_ALL+set} ]]; then caller_lc_all=$LC_ALL; fi
export LC_ALL=C
set -o nounset -o pipefail
shopt -s nullglob dotglob globstar
unset TMUX TMUX_PANE

if (( BASH_VERSINFO[0] < 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] < 2) )); then
  printf '%s\n' "workplace: bash ${BASH_VERSION} found; 5.2 or later is needed" >&2
  exit 2
fi

TMUX_FLOOR=3.5a
JQ_FLOOR=1.7
ALWAYS=(tmux setpriv env mkdir cp rm sha256sum stat)

say() { printf '%s\n' "$*"; }
warn() { printf '%s\n' "workplace: $*" >&2; }
die() { warn "$1"; exit "${2:-1}"; }

source_dir=${BASH_SOURCE[0]}
case $source_dir in
  */*) source_dir=${source_dir%/*} ;;
  *) source_dir=. ;;
esac
tool=$(cd -P -- "$source_dir/.." && pwd -P) || die "cannot find the tool's directory" 2

version_key() {
  [[ $1 =~ ^([0-9]+)\.([0-9]+)([a-z]?)$ ]] || return 1
  local letter=0
  [[ -n ${BASH_REMATCH[3]} ]] && printf -v letter '%d' "'${BASH_REMATCH[3]}"
  printf '%s\n' "$(( BASH_REMATCH[1] * 1000000 + BASH_REMATCH[2] * 1000 + letter ))"
}

at_least() {
  local have want
  have=$(version_key "$1") || return 1
  want=$(version_key "$2") || return 1
  (( have >= want ))
}

version_of() {
  local program=$1 flag=$2 version
  version=$("$program" "$flag" 2> /dev/null) || return 1
  [[ $version =~ ([0-9]+\.[0-9]+[a-z]?) ]] || return 1
  printf '%s\n' "${BASH_REMATCH[1]}"
}

need_version() {
  local program=$1 flag=$2 floor=$3 found
  command -v "$program" > /dev/null || die "$program $floor or later is needed and is not on PATH" 2
  found=$(version_of "$program" "$flag") || die "cannot read $program's version" 2
  at_least "$found" "$floor" || die "$program $found found; $floor or later is needed" 2
}

need_jq() { need_version jq --version "$JQ_FLOOR"; }
need_tmux() { need_version tmux -V "$TMUX_FLOOR"; }

need_programs() {
  local program found
  program_slots='{}'
  for program in "${ALWAYS[@]}" "$@"; do
    found=$(command -v -- "$program") || die "this plan needs $program, and $program is not on PATH" 2
    [[ $found == /* ]] || die "$program resolves to $found, which is not a program on PATH" 2
    [[ $found != *=* ]] || die "$program resolves to $found, whose path holds =, which env would read as a variable" 2
    program_slots=$(jq -c --arg n "$program" --arg p "$found" '.[(["program", $n] | tojson)] = $p' <<< "$program_slots")
  done
}

locate() {
  [[ -n ${WORKPLACE_ROOT-} ]] || die "WORKPLACE_ROOT is not set" 2
  [[ -n ${WORKPLACE_CONFIG-} ]] || die "WORKPLACE_CONFIG is not set" 2
  [[ $WORKPLACE_ROOT == /* && -d $WORKPLACE_ROOT ]] \
    || die "WORKPLACE_ROOT must be the absolute path of a directory: $WORKPLACE_ROOT" 2
  [[ $WORKPLACE_CONFIG == /* && -d $WORKPLACE_CONFIG ]] \
    || die "WORKPLACE_CONFIG must be the absolute path of a directory: $WORKPLACE_CONFIG" 2
  root=$(cd -P -- "$WORKPLACE_ROOT" && pwd -P) || die "cannot enter WORKPLACE_ROOT: $WORKPLACE_ROOT" 2
  clone=$(cd -P -- "$WORKPLACE_CONFIG" && pwd -P) || die "cannot enter WORKPLACE_CONFIG: $WORKPLACE_CONFIG" 2
  if [[ $root != / && $clone != "$root" && $clone != "$root"/* ]]; then
    die "WORKPLACE_CONFIG ($clone) is not at or below WORKPLACE_ROOT ($root)" 2
  fi
  plan_dir=$clone/PLAN
  build_dir=$clone/BUILD
  run_dir=$build_dir/RUN
}

jq_message() {
  local text
  IFS= read -r -d '' text < "$1" || :
  text=${text%$'\n'}
  text=${text#jq: error (at *): }
  printf '%s' "$text"
}

json_list() {
  if (( $# )); then
    printf '%s\0' "$@" | jq -R -s -c 'split("\u0000")[:-1]'
  else
    printf '%s\n' '[]'
  fi
}

plan_report() {
  local plan=$1 binding=$2 checker=$3 folded_view=${4:-/dev/null} errors
  report=$(jq -c -L "${checker%/*}" --slurpfile b "$binding" --slurpfile folded "$folded_view" -f "$checker" "$plan" 2>&1) \
    || die "the plan is not JSON that jq can read: $report"
  [[ -n $report ]] || die "the plan $plan is empty"
  mapfile -t errors < <(jq -r '.errors[]' <<< "$report")
  if (( ${#errors[@]} )); then
    printf '%s\n' "${errors[@]/#/workplace: }" >&2
    exit 1
  fi
  mapfile -t plan_programs < <(jq -r '.programs[]' <<< "$report")
  plan_terms=$(jq -r '.terms' <<< "$report")
}

sha_of() {
  local sum
  sum=$(sha256sum < "$1" 2> /dev/null) || return 1
  printf '%s\n' "${sum%%  *}"
}

collect_facts() {
  local path type mode uid named
  local -a fields
  for path in "$@"; do
    mapfile -d '' -t fields < <(QUOTING_STYLE=literal stat --printf '%F\0%a\0%u\0%N\0' -- "$path" 2> /dev/null)
    (( ${#fields[@]} == 4 )) || continue
    type=${fields[0]} mode=${fields[1]} uid=${fields[2]} named=${fields[3]}
    while (( ${#mode} < 4 )); do mode=0$mode; done
    printf '%s\0%s\0%s\0' exists "$path" ""
    [[ $type == directory ]] && printf '%s\0%s\0%s\0' directory "$path" ""
    [[ $type == "symbolic link" ]] && printf '%s\0%s\0%s\0' symlink "$path" "${named#"$path -> "}"
    printf '%s\0%s\0%s\0' mode "$path" "$mode"
    printf '%s\0%s\0%s\0' owner "$path" "$uid"
  done
}

check_facts() {
  local facts=$1 differences problems
  problems=$(jq -r --arg root "$root" '
    def canonical: . == "/" or (startswith("/") and (endswith("/") | not) and (.[1:] | split("/") | all(. != "" and . != "." and . != "..")));
    (if .root != $root then "the facts file belongs to the root \(.root), not to \($root)" else empty end),
    (.facts[] | if (.fact | IN("exists", "directory", "symlink", "mode", "owner") | not) then "the facts file holds an unknown fact \(.fact)"
               elif ((.args | length) != 1 or (.args[0] | type) != "string" or (.args[0] | canonical | not)) then "the facts file names a path that is not absolute and canonical: \(.args)"
               else empty end)' "$facts") || die "cannot read the plan's facts"
  if [[ -n $problems ]]; then
    printf '%s\n' "$problems" | while IFS= read -r line; do warn "$line"; done
    return 1
  fi
  local -a paths
  mapfile -t paths < <(jq -r '[.facts[].args[0]] | unique | .[]' "$facts")
  local collected
  collected=$(collect_facts "${paths[@]}" | jq -R -s -c \
    'split("\u0000")[:-1] | [range(0; length; 3) as $i | .[$i:$i + 3]]
     | map({fact: .[0], args: [.[1]]} + (if .[0] | IN("exists", "directory") then {} else {value: .[2]} end))') \
    || die "cannot collect the machine's facts"
  differences=$(jq -r --argjson now "$collected" '
    def by($f): [$f[] | {key: ([.fact, .args[0]] | tojson), value: .}] | from_entries;
    by($now) as $machine
    | .facts[] | . as $v | ([.fact, .args[0]] | tojson) as $k
    | if ($machine | has($k) | not) then
        "fact \(.fact) of \(.args[0]): the plan says \(.value // true), the machine has no such fact"
      elif (has("value")) and $machine[$k].value != .value then
        "fact \(.fact) of \(.args[0]): the plan says \(.value), the machine says \($machine[$k].value)"
      else empty end
  ' "$facts") || die "cannot compare the plan's facts"
  if [[ -n $differences ]]; then
    printf '%s\n' "$differences" | while IFS= read -r line; do warn "$line"; done
    return 1
  fi
}

derive_name() {
  local rule=$1 sum
  case $rule in
    sha256-path-prefix12-v1)
      sum=$(printf '%s' "$clone" | sha256sum) || return 1
      printf '%s\n' "${clone##*/}-${sum:0:12}"
      ;;
    *) return 1 ;;
  esac
}

check_name() {
  local manifest=$1 name default rule derived
  name=$(jq -r '.name // ""' <<< "$report")
  default=$(jq -r '.name.default // ""' "$tool/host/binding.json")
  [[ -n $default && $name == "$default" ]] && return 0
  rule=$(jq -r '.derivations["workplace-name"] // "" | strings' "$manifest")
  if [[ -z $rule ]]; then
    warn "the plan names the workplace $name, and the manifest names no rule for the workplace's name (derivations.workplace-name)"
    return 1
  fi
  if ! derived=$(derive_name "$rule"); then
    warn "the manifest names the rule $rule for the workplace's name, and this loop does not know it"
    return 1
  fi
  [[ $name == "$derived" ]] && return 0
  warn "the plan names the workplace $name; by the rule $rule its clone $clone gives $derived"
  return 1
}

work_dir() {
  local dir
  dir=${TMPDIR:-/tmp}/workplace-$1-$$-$SRANDOM
  mkdir -m 0700 -- "$dir" || die "cannot make $dir" 2
  printf '%s\n' "$dir"
}

assemble() {
  local into=$1 file=$clone/workplace.json problems line
  [[ -f $file && ! -L $file ]] || die "$file is missing; the clone of a workplace holds workplace.json" 2
  problems=$(jq -r '
    def path_word: type == "string" and (test("[[:cntrl:]]") | not) and (startswith("/") | not)
      and (split("/") | all(. != "" and . != "." and . != ".."));
    if type != "object" then "workplace.json is not an object"
    else
      (keys[] | select(IN("layers", "socket") | not) | "workplace.json holds \(.), which the loop does not read"),
      (if (.layers | type) != "array" or (.layers | length) == 0 then "workplace.json names no layers"
       else
         (.layers[] | select(path_word | not) | "workplace.json names a layer that is not a relative path: \(tojson)"),
         ([.layers[] | strings | sub("^.*/"; "") | sub("\\.typify$"; "")] | group_by(.)[] | select(length > 1)
          | "the layer name \(.[0]) is listed \(length) times in workplace.json")
       end),
      (if has("socket") and .socket != "default" then "workplace.json says socket \(.socket | tojson), and only \"default\" is known" else empty end)
    end' "$file" 2>&1) || die "workplace.json is not JSON that jq can read: $problems" 2
  if [[ -n $problems ]]; then
    while IFS= read -r line; do warn "$line"; done <<< "$problems"
    exit 2
  fi
  local -a layers lines
  mapfile -t layers < <(jq -r '.layers[]' "$file")
  assembled_name=default
  if [[ $(jq -r '.socket // ""' "$file") != default ]]; then
    assembled_name=$(derive_name sha256-path-prefix12-v1) || die "cannot derive the workplace's name" 2
  fi
  local declarations=$into/LanguageDeclarations.typify layer path content size at=1 i language
  local -A declared=()
  printf '%s\n' '#lang typify' > "$declarations" || die "cannot write $declarations" 2
  assembled_map='[]'
  for layer in "${layers[@]}"; do
    path=$clone/$layer
    [[ -f $path && ! -L $path ]] || die "the layer $layer is not a file in $clone" 2
    content=""
    IFS= read -r -d '' content < "$path" || :
    size=$(stat -c %s -- "$path") || die "cannot read $path" 2
    (( ${#content} == size )) || die "the layer $layer holds a NUL byte" 2
    [[ $content != $'\xef\xbb\xbf'* ]] || die "the layer $layer begins with a byte-order mark, and the assembler does not convert it" 2
    [[ $content != *$'\r'* ]] || die "the layer $layer has CR line ends, and the assembler does not convert them" 2
    [[ $content == *$'\n' ]] || die "the layer $layer does not end with a newline" 2
    mapfile -t lines <<< "${content%$'\n'}"
    [[ ${lines[0]} == '#lang typify' ]] || die "the layer $layer does not begin with the header #lang typify" 2
    for (( i = 1; i < ${#lines[@]}; i++ )); do
      [[ ${lines[i]} =~ ^declare[[:space:]]*:[[:space:]]*(.*[^[:space:]])[[:space:]]*$ ]] || continue
      language=${BASH_REMATCH[1]}
      [[ -z ${declared[$language]+x} ]] \
        || die "the language $language is declared twice: at ${declared[$language]} and at $layer:$(( i + 1 ))" 2
      declared[$language]=$layer:$(( i + 1 ))
    done
    if (( ${#lines[@]} > 1 )); then
      printf '%s\n' "${lines[@]:1}" >> "$declarations" || die "cannot write $declarations" 2
    fi
    assembled_map=$(jq -c --arg s "$layer" --argjson a "$(( at + 1 ))" --argjson n "$(( ${#lines[@]} - 1 ))" \
      '. + [{source: $s, source_start_line: 2, assembled_start_line: $a, line_count: $n}]' <<< "$assembled_map")
    at=$(( at + ${#lines[@]} - 1 ))
  done
  [[ -d $clone/programs && ! -L $clone/programs ]] || die "$clone/programs is missing; the clone holds its programs there" 2
  [[ -f $clone/tmux.conf && ! -L $clone/tmux.conf ]] || die "$clone/tmux.conf is missing" 2
  local -a programs=()
  for path in "$clone"/programs/**; do
    [[ -L $path ]] && die "${path#"$clone"/} is a symbolic link; the assembler copies files only" 2
    [[ -d $path ]] && continue
    [[ -f $path ]] || die "${path#"$clone"/} is not a file" 2
    content=""
    IFS= read -r -d '' content < "$path" || :
    [[ $content != $'\xef\xbb\xbf'* ]] || die "the program ${path#"$clone"/} begins with a byte-order mark, and the assembler does not convert it" 2
    [[ $content != *$'\r'* ]] || die "the program ${path#"$clone"/} has CR line ends, and the assembler does not convert them" 2
    programs+=("${path#"$clone"/}")
  done
  (( ${#programs[@]} )) || die "$clone/programs holds no program" 2
  local conf
  if [[ $clone == "$root" ]]; then conf=tmux.conf
  elif [[ $root == / ]]; then conf=${clone#/}/tmux.conf
  else conf=${clone#"$root"/}/tmux.conf; fi
  [[ $root$assembled_name$conf != *[[:cntrl:]]* ]] || die "the root, the name or the configuration's path holds a control character" 2
  mkdir -- "$into/tree" && cp -R -- "$clone/programs" "$into/tree/programs" || die "cannot copy the programs into $into/tree" 2
  printf '%s\n' "workdir : $root" "server : $assembled_name : $conf" > "$into/tree/ROOT.typify" || die "cannot write the root program" 2
  local -a inputs
  mapfile -d '' -t inputs < <(printf '%s\0' "${programs[@]}" | jq -R -s --raw-output0 'split("\u0000")[:-1] | sort[]')
  inputs=(workplace.json "${layers[@]}" "${inputs[@]}" tmux.conf)
  assembled_inputs=$(for path in "${inputs[@]}"; do
      printf '%s\0%s\0' "$path" "$(sha_of "$clone/$path")" || exit 1
    done | jq -R -s -c 'split("\u0000")[:-1] | [range(0; length; 2) as $i | {path: .[$i], sha256: .[$i + 1]}]') \
    || die "cannot hash the inputs" 2
  assembled_generated=$(jq -n -c --arg d "$(sha_of "$declarations")" --arg r "$(sha_of "$into/tree/ROOT.typify")" \
    '[{path: "LanguageDeclarations.typify", sha256: $d}, {path: "tree/ROOT.typify", sha256: $r}]')
}

folds() {
  jq -e -L "$tool/libexec" --slurpfile b "$2" 'include "table"; . as $plan | any($b[0].tables[]; folded($plan; .))' "$1" > /dev/null 2>&1
}

fold_plan() {
  folded=$(jq -c -L "$tool/libexec" -f "$tool/libexec/fold.jq" "$1" 2>&1) || die "the fold cannot read $1: $folded" 2
  local -a errors
  mapfile -t errors < <(jq -r '.errors[]?' <<< "$folded")
  if (( ${#errors[@]} )); then
    printf '%s\n' "${errors[@]/#/workplace: the fold refuses: }" >&2
    return 1
  fi
}

show_diagnostics() {
  local output=$1 declarations=$2 tree=$3
  jq -r --arg d "$declarations" --arg t "$tree/" --argjson map "$assembled_map" '
    def place($f; $l):
      if $f == $d then
        if $l == null then "the assembled declarations"
        elif $l == 1 then "the header of the assembled declarations, which the assembler writes"
        else ([$map[] | select($l >= .assembled_start_line and $l < .assembled_start_line + .line_count)][0]) as $m
          | if $m == null then "the assembled declarations, line \($l)"
            else "\($m.source):\($l - $m.assembled_start_line + $m.source_start_line)" end
        end
      elif ($f | type) == "string" and ($f | startswith($t)) then
        ($f | ltrimstr($t)) as $r
        | if $r == "ROOT.typify" then "the generated root program, line \($l // "?")" else "\($r):\($l // "?")" end
      else "\($f // "the reader"):\($l // "?")" end;
    (.diagnostics // [])[]
    | "\(place(.file; .range.start.line?)): \(.severity) \(.code): \(.message)"
      + (if .file == $d and .range.start.line? != null then " (the reader: LanguageDeclarations.typify:\(.range.start.line))" else "" end)
  ' <<< "$output" 2> /dev/null
}

print_fold_report() {
  jq -r '
    def at($o): "\($o.path // "?"):\($o.line // "?")";
    def ats($os): [$os[] | at(.)] | join(", ");
    def said($s): "\($s.term[4]) \([$s.term[1:4][] | select(. != "-")] | join("/") | if . == "" then "" else . + " " end)\($s.term[5]) \($s.term[6]) (\(ats($s.origins)))";
    .report.names as $names
    | (.view.seats[]
       | "seat \($names[.seat | tojson]) (\(.seat | join("/"))): kind \(.kind); clearance \(.clearance.value)"
         + (if .clearance.scope == null then ", by default" else ", the \(.clearance.scope)'"'"'s (\(ats(.clearance.origins)))" end)
         + "; \(.rows) rows",
         (.replacement_statements[] | "  \(said(.statement)) replaced:", (.replaced[] | "    \(said(.))")),
         (.statements_at_labelled_paths[] | "  stands at a labelled path: \(said(.statement)), label \(.label.value) (\(ats(.label.origins)))"),
         "  exceptions \(.exception_count), statements replaced \(.distinct_replaced_statement_count), statements at labelled paths \(.statements_at_labelled_paths | length)"),
      (.report.pairs[] | "label \(.lower.path) (\(.lower.value)) lies beneath \(.upper.path) (\(.upper.value)), and opens nothing to the seats between: \(if (.between | length) == 0 then "none" else .between | join(", ") end)")
  ' <<< "$folded"
}

held_by_nobody() {
  local view=$1 path child verdict
  local -a queue
  mapfile -t queue < <(jq -r '[.rows[] | select(.value[0] == "searchable-only") | .key[3]] | unique[]' "$view")
  local -a found=()
  while (( ${#queue[@]} )); do
    path=${queue[0]}
    queue=("${queue[@]:1}")
    for child in "$path"/*/; do
      child=${child%/}
      [[ $child == //* ]] && child=${child#/}
      [[ -L $child ]] && continue
      verdict=$(jq -r --arg d "$child" '
        def beneath($p; $q): ($q == "/" and $p != "/") or ($p | startswith($q + "/"));
        [.rows | group_by(.key[0:3])[]
         | if any(.[]; .key[3] == $d or beneath(.key[3]; $d)) then "named"
           else ([.[] | select(beneath($d; .key[3]))] | max_by(.key[3] | length)) as $above
             | if $above == null or ($above.value[0] | IN("hidden", "searchable-only", "scratch") | not) then "seen" else "unseen" end
           end] as $all
        | if any($all[]; . == "seen") then "seen"
          elif all($all[]; . == "unseen") then "nobody"
          else "through" end' "$view")
      case $verdict in
        nobody) found+=("$child") ;;
        through) queue+=("$child") ;;
      esac
    done
  done
  (( ${#found[@]} )) || return 0
  say "held by nobody, a report and no part of the plan:"
  printf '  %s\n' "${found[@]}"
}

cmd_plan() {
  local name
  (( $# == 0 )) || die "plan takes no arguments; it reads the clone at WORKPLACE_CONFIG" 2
  need_jq
  locate
  local reader version
  reader=$(command -v typify) || die "plan needs the reader, the program typify on PATH, and it is not there" 2
  work=$(work_dir plan)
  trap 'rm -rf -- "$work"' EXIT
  trap 'exit 130' INT TERM
  assemble "$work"
  version=$("$reader" --version 2> /dev/null) || die "the reader $reader does not answer --version" 2
  version=${version%%$'\n'*}
  [[ -n ${version//[[:space:]]/} ]] || die "the reader $reader states no version, and plan stops here" 2
  local output status declarations=$work/LanguageDeclarations.typify
  output=$("$reader" check "$declarations" --json 2> "$work/check.err")
  status=$?
  if (( status != 0 )); then
    warn "the reader refuses the declarations:"
    show_diagnostics "$output" "$declarations" "$work/tree" >&2 || sed 's/^/  /' "$work/check.err" >&2
    exit $(( status == 1 ? 1 : 2 ))
  fi
  "$reader" plan "$declarations" "$work/tree" --json > "$work/plan.json" 2> "$work/plan.err"
  status=$?
  if (( status != 0 )); then
    warn "the reader refuses the programs:"
    show_diagnostics "$(< "$work/plan.json")" "$declarations" "$work/tree" >&2 || sed 's/^/  /' "$work/plan.err" >&2
    exit $(( status == 1 ? 1 : 2 ))
  fi
  local facts
  facts=$(jq -r '.facts // "absent" | tostring' "$work/plan.json") || die "the reader's plan is not JSON that jq can read" 2
  [[ $facts == none ]] \
    || die "the plan was made on facts ($facts); a plan whose facts member is not none is refused for now, since 5.15 leaves open which facts build compares"
  local -a outputs=(plan.json)
  folded=""
  if folds "$work/plan.json" "$tool/host/binding.json"; then
    fold_plan "$work/plan.json" || exit 1
    jq '.view' <<< "$folded" > "$work/view.json" || die "cannot write the view"
    outputs+=(view.json)
  fi
  local out_json
  out_json=$(for name in "${outputs[@]}"; do printf '%s\0%s\0' "$name" "$(sha_of "$work/$name")"; done \
    | jq -R -s -c 'split("\u0000")[:-1] | [range(0; length; 2) as $i | {path: .[$i], sha256: .[$i + 1]}]')
  jq -n --arg root "$root" --arg name "$assembled_name" --arg reader "$version" \
    --argjson inputs "$assembled_inputs" --argjson generated "$assembled_generated" \
    --argjson map "$assembled_map" --argjson outputs "$out_json" '
    {root: $root, name: $name, reader: $reader,
     derivations: {assembly: "whole-bodies-v1", "root-program": "root-two-lines-v1",
                   "workplace-name": "sha256-path-prefix12-v1", fold: "frame-5.17-5.18-v1"},
     inputs: $inputs, generated: $generated, source_map: $map, outputs: $outputs}' > "$work/manifest.json" \
    || die "cannot write the manifest"
  trap '' INT TERM
  rm -rf -- "$plan_dir" && mkdir -- "$plan_dir" || die "cannot replace $plan_dir; run plan again" 2
  for name in "${outputs[@]}" manifest.json; do
    cp -- "$work/$name" "$plan_dir/$name" || die "cannot write $plan_dir/$name; PLAN/ is incomplete, run plan again" 2
  done
  trap 'exit 130' INT TERM
  say "planned $plan_dir: the reader $version; $(jq -r '[.programs[].plan | length] | add' "$plan_dir/plan.json") terms"
  for name in "${outputs[@]}" manifest.json; do
    say "  $name $(sha_of "$plan_dir/$name")"
  done
  if [[ -n $folded ]]; then
    print_fold_report
    held_by_nobody "$plan_dir/view.json"
  fi
  return 0
}

reassemble_and_compare() {
  local manifest=$1 differences line
  work=$(work_dir build)
  trap 'rm -rf -- "$work"' EXIT
  trap 'exit 130' INT TERM
  assemble "$work"
  differences=$(jq -r --arg name "$assembled_name" --argjson inputs "$assembled_inputs" --argjson generated "$assembled_generated" '
    def by: map({key: .path, value: .sha256}) | from_entries;
    (if .name != $name then "the manifest names the workplace \(.name), and the clone assembles it as \($name)" else empty end),
    ((($inputs | map(.path)) - (.inputs | map(.path)))[] | "the clone holds the input \(.), which the manifest does not list"),
    (((.inputs | map(.path)) - ($inputs | map(.path)))[] | "the manifest lists the input \(.), which the assembly does not read"),
    (((.generated // []) | by) as $then | ($generated | by) as $now
     | (($now | keys[]) as $p
        | if ($then | has($p) | not) then "the manifest does not list the generated \($p)"
          elif $then[$p] != $now[$p] then "the generated \($p) is not the one the plan was made from"
          else empty end),
       ($then | keys[] | select(. as $p | $now | has($p) | not) | "the manifest lists a generated \(.), which the assembler does not make"))
  ' "$manifest") || die "cannot compare the assembly with the manifest"
  rm -rf -- "$work"
  trap - EXIT INT TERM
  [[ -z $differences ]] && return 0
  while IFS= read -r line; do warn "$line"; done <<< "$differences"
  return 1
}

manifest_files=(plan.json plan-manifest.json binding.json bin/workplace libexec/resolve.jq libexec/check.jq libexec/table.jq libexec/fold.jq)

cmd_build() {
  (( $# == 0 )) || die "build takes no arguments; it reads PLAN/ in the configuration's clone" 2
  need_jq
  locate
  local name
  for name in "${ALWAYS[@]}"; do command -v "$name" > /dev/null || die "build needs $name, and $name is not on PATH" 2; done
  if [[ -e $build_dir || -L $build_dir ]]; then
    die "$build_dir exists; build refuses until it is removed"
  fi
  for name in plan.json manifest.json; do
    [[ -f $plan_dir/$name ]] || die "PLAN/$name is missing from $clone" 2
  done
  local facts_member
  facts_member=$(jq -r '.facts // "absent" | if type == "string" then . else "not a string" end' "$plan_dir/plan.json" 2> /dev/null) \
    || die "PLAN/plan.json is not JSON that jq can read"
  local manifest=$plan_dir/manifest.json declared
  jq -e 'type == "object" and (.root | type) == "string" and (.inputs | type) == "array" and (.outputs | type) == "array"' \
    "$manifest" > /dev/null 2>&1 || die "PLAN/manifest.json is not a manifest: it needs root, inputs and outputs"
  declared=$(jq -r '.root' "$manifest")
  [[ $declared == "$root" || $declared == "${WORKPLACE_ROOT%/}" ]] \
    || die "the plan belongs to the root $declared, not to $root"
  local -a entries
  local path want got bad=0 i
  mapfile -t entries < <(jq -r '.inputs[] | "\(.sha256)\t\(.path)"' "$manifest")
  for line in "${entries[@]}"; do
    want=${line%%$'\t'*}
    path=${line#*$'\t'}
    [[ $path == /* ]] || path=$clone/$path
    if ! got=$(sha_of "$path"); then warn "the input $path is missing"; bad=1
    elif [[ $got != "$want" ]]; then warn "the input $path has changed since the plan was made"; bad=1; fi
  done
  local covered
  covered=$(jq -r --arg facts "$([[ -f $plan_dir/facts.json ]] && printf '%s' yes)" \
    --arg view "$([[ -f $plan_dir/view.json ]] && printf '%s' yes)" '
    [.outputs[].path] as $listed
    | (["plan.json"] + (if $facts == "yes" then ["facts.json"] else [] end) + (if $view == "yes" then ["view.json"] else [] end))[]
    | select(. as $f | $listed | index($f) | not)' "$manifest")
  [[ -z $covered ]] || die "PLAN/manifest.json does not list $(printf '%s ' $covered)among its outputs"
  mapfile -t entries < <(jq -r '.outputs[] | "\(.sha256)\t\(.path)"' "$manifest")
  for line in "${entries[@]}"; do
    want=${line%%$'\t'*}
    path=$plan_dir/${line#*$'\t'}
    if ! got=$(sha_of "$path"); then warn "the plan's file $path is missing"; bad=1
    elif [[ $got != "$want" ]]; then warn "the plan's file $path has changed since the plan was made"; bad=1; fi
  done
  (( bad == 0 )) || die "build refuses: the plan no longer matches its sources"
  if [[ -e $clone/workplace.json ]] || jq -e '.generated != null' "$manifest" > /dev/null 2>&1; then
    reassemble_and_compare "$manifest" || die "build refuses: the clone no longer assembles to what the plan was made from"
  fi
  local view_file=/dev/null
  if folds "$plan_dir/plan.json" "$tool/host/binding.json"; then
    [[ -f $plan_dir/view.json ]] || die "the plan holds statements, and PLAN/view.json, its folded view, is missing" 2
    fold_plan "$plan_dir/plan.json" || die "build refuses: the fold refuses PLAN/plan.json"
    local refolded=$build_dir.view-$$
    jq '.view' <<< "$folded" > "$refolded" || die "cannot write $refolded" 2
    local -a differing
    mapfile -t differing < <(jq -r --slurpfile now "$refolded" '
      if . == $now[0] then empty
      else
        ([.seats[]?.seat] + [$now[0].seats[].seat] | unique[]) as $k
        | select(([.rows[]? | select(.key[0:3] == $k)] != [$now[0].rows[] | select(.key[0:3] == $k)])
                 or ([.seats[]? | select(.seat == $k)] != [$now[0].seats[] | select(.seat == $k)]))
        | $k | join("/")
      end, (if . == $now[0] then "same" else "differs" end)' "$plan_dir/view.json" 2> /dev/null)
    rm -f -- "$refolded"
    (( ${#differing[@]} )) || die "PLAN/view.json is not JSON that jq can read"
    [[ ${differing[-1]} == same ]] || {
      unset 'differing[-1]'
      local IFS=,
      die "PLAN/view.json is not the fold of PLAN/plan.json; it differs for ${differing[*]:-its form}"
    }
    view_file=$plan_dir/view.json
  fi
  plan_report "$plan_dir/plan.json" "$tool/host/binding.json" "$tool/libexec/check.jq" "$view_file"
  check_name "$manifest" || die "build refuses: the plan's workplace name is not the one its clone gives"
  if [[ $facts_member == none ]]; then
    :
  elif [[ $facts_member =~ ^sha256:[0-9a-f]{64}$ ]]; then
    [[ -f $plan_dir/facts.json ]] || die "the plan was made on facts with the digest $facts_member, and PLAN/facts.json is missing" 2
    [[ sha256:$(sha_of "$plan_dir/facts.json") == "$facts_member" ]] \
      || die "PLAN/facts.json is not the facts file the plan was made on ($facts_member)"
    check_facts "$plan_dir/facts.json" || die "build refuses: the machine differs from the facts the plan was made on"
  else
    die "the plan's facts member is $facts_member, neither none nor a sha256 digest"
  fi
  local -a must
  mapfile -t must < <(jq -r '.must_exist[]' <<< "$report")
  for path in "${must[@]}"; do
    [[ -e $path ]] || { warn "a view grants $path, which does not exist"; bad=1; }
  done
  mapfile -t must < <(jq -r '.must_be_directory[]' <<< "$report")
  for path in "${must[@]}"; do
    [[ -d $path ]] || { warn "a view makes $path a tmpfs, and it is not a directory"; bad=1; }
  done
  local -a tests
  mapfile -d '' -t tests < <(jq --raw-output0 '.requires[][]' <<< "$report")
  where=build
  for (( i = 0; i + 1 < ${#tests[@]}; i += 2 )); do
    meets "${tests[i]}" "${tests[i + 1]}" || bad=1
  done
  (( bad == 0 )) || die "build refuses: a path the plan names is missing or of the wrong kind"
  local -a sources=("$plan_dir/plan.json" "$plan_dir/manifest.json" "$tool/host/binding.json"
    "$tool/bin/workplace" "$tool/libexec/resolve.jq" "$tool/libexec/check.jq" "$tool/libexec/table.jq" "$tool/libexec/fold.jq")
  local -a listed=("${manifest_files[@]}")
  if [[ -f $plan_dir/facts.json ]]; then
    sources+=("$plan_dir/facts.json")
    listed+=(plan-facts.json)
  fi
  if [[ -f $plan_dir/view.json ]]; then
    sources+=("$plan_dir/view.json")
    listed+=(plan-view.json)
  fi
  mkdir -- "$build_dir" || die "cannot make $build_dir"
  trap 'rm -rf -- "$build_dir"' EXIT
  trap 'exit 130' INT TERM
  if ! {
    mkdir -- "$build_dir/libexec" "$build_dir/bin" &&
      cp -- "$plan_dir/plan.json" "$build_dir/plan.json" &&
      { [[ ! -f $plan_dir/facts.json ]] || cp -- "$plan_dir/facts.json" "$build_dir/plan-facts.json"; } &&
      { [[ ! -f $plan_dir/view.json ]] || cp -- "$plan_dir/view.json" "$build_dir/plan-view.json"; } &&
      cp -- "$plan_dir/manifest.json" "$build_dir/plan-manifest.json" &&
      cp -- "$tool/host/binding.json" "$build_dir/binding.json" &&
      cp -- "$tool/bin/workplace" "$build_dir/bin/workplace" &&
      cp -- "$tool/libexec/resolve.jq" "$tool/libexec/check.jq" "$tool/libexec/table.jq" "$tool/libexec/fold.jq" "$build_dir/libexec/"
  }; then
    rm -rf -- "$build_dir"
    die "build failed; $build_dir was removed"
  fi
  local -a source_sums copy_sums
  mapfile -t source_sums < <(sha256sum -- "${sources[@]}")
  mapfile -t copy_sums < <(cd -- "$build_dir" && sha256sum -- "${listed[@]}")
  (( ${#copy_sums[@]} == ${#sources[@]} )) || { rm -rf -- "$build_dir"; die "cannot hash the build; $build_dir was removed"; }
  for i in "${!sources[@]}"; do
    if [[ ${source_sums[i]%%  *} != "${copy_sums[i]%%  *}" ]]; then
      rm -rf -- "$build_dir"
      die "the copy of ${sources[i]} differs from its source; $build_dir was removed"
    fi
  done
  printf '%s\n' "${copy_sums[@]}" > "$build_dir/MANIFEST" || die "cannot write $build_dir/MANIFEST"
  local sum
  sum=$(sha_of "$build_dir/MANIFEST") || die "cannot hash $build_dir/MANIFEST"
  trap - EXIT INT TERM
  say "built $build_dir: $plan_terms terms; manifest $sum"
  say "the plan's reader: $(jq -r '.reader // "not given"' "$manifest")"
  say "its derivations: $(jq -r '(.derivations // {}) | to_entries | map("\(.key) \(.value)") | join(", ")' "$manifest")"
}

verify_build() {
  [[ -d $build_dir ]] || { warn "no build at $build_dir"; return 1; }
  [[ -f $build_dir/MANIFEST && ! -L $build_dir/MANIFEST ]] || { warn "$build_dir has no MANIFEST"; return 1; }
  local -A want=()
  local line name file rel
  while IFS= read -r line; do
    name=${line#*  }
    [[ $line == *"  "* && -n $name ]] || { warn "MANIFEST holds a line that is not a hash and a name"; return 1; }
    want[$name]=${line%%  *}
  done < "$build_dir/MANIFEST"
  for file in "$build_dir"/**; do
    rel=${file#"$build_dir"/}
    [[ $rel == MANIFEST || $rel == RUN || $rel == RUN/* ]] && continue
    if [[ -L $file ]]; then warn "$build_dir holds a symbolic link: $rel"; return 1; fi
    [[ -d $file ]] && continue
    [[ -n ${want[$rel]+x} ]] || { warn "$build_dir holds a file its MANIFEST does not list: $rel"; return 1; }
  done
  for name in "${manifest_files[@]}"; do
    [[ -n ${want[$name]+x} ]] || { warn "MANIFEST does not list $name"; return 1; }
  done
  local -a sums
  mapfile -t sums < <(cd -- "$build_dir" && sha256sum -- "${!want[@]}" 2> /dev/null)
  (( ${#sums[@]} == ${#want[@]} )) || { warn "a file the MANIFEST lists is missing from $build_dir"; return 1; }
  for line in "${sums[@]}"; do
    name=${line#*  }
    [[ ${line%%  *} == "${want[$name]}" ]] || { warn "$build_dir/$name does not match its MANIFEST"; return 1; }
  done
  return 0
}

caller_locale() {
  if [[ -n ${caller_lc_all+set} ]]; then LC_ALL=$caller_lc_all; else unset LC_ALL; fi
} 2> /dev/null

run_call() {
  local -n _out=$1
  shift
  _out=$(caller_locale; "$@" 2> "$run_dir/call.err")
}

log_call() {
  json_list "$@" >> "$run_dir/calls.jsonl"
}

teardown() {
  local mode=${1:-down}
  undo_failed=0
  [[ -f $run_dir/ledger ]] || return 0
  local -a records fields when call
  local i n record what is out
  mapfile -t records < "$run_dir/ledger"
  for (( i = ${#records[@]} - 1; i >= 0; i-- )); do
    record=${records[i]}
    mapfile -d '' -t fields < <(jq --raw-output0 \
      '.what, (.is // ""), ((.when // []) | length | tostring), (.when // [])[], (.call | length | tostring), .call[]' <<< "$record")
    what=${fields[0]}
    is=${fields[1]}
    n=${fields[2]}
    when=("${fields[@]:3:n}")
    call=("${fields[@]:3+n+1}")
    if (( n )) && [[ $mode == down ]]; then
      if ! run_call out "${when[@]}"; then
        say "undo $what: already gone"
        continue
      fi
      if [[ $out != "$is" ]]; then
        say "undo $what: it does not carry this run's mark, left alone"
        continue
      fi
    fi
    if run_call out "${call[@]}"; then
      say "undo $what: done"
    elif [[ $mode == down ]]; then
      warn "undo $what: failed: $(jq_message "$run_dir/call.err")"
      undo_failed=1
    else
      say "undo $what: already gone"
    fi
  done
}

resolve_step() {
  local phase=$1 term=$2 caps=$3
  jq -n --raw-output0 \
    --argjson st "$state" --argjson term "$term" --argjson caps "$caps" \
    --slurpfile b "$build_dir/binding.json" --slurpfile t "$run_dir/tables.json" \
    --arg build "$build_dir" --arg phase "$phase" \
    -f "$build_dir/libexec/resolve.jq" > "$run_dir/step" 2> "$run_dir/step.err"
}

meets() {
  local test=$1 value=$2 line
  case $test in
    directory) [[ -d $value ]] || { warn "$where: $value is not a directory"; return 1; } ;;
    file) [[ -f $value ]] || { warn "$where: $value is not a file"; return 1; } ;;
    name) [[ -n $value && $value != */* ]] || { warn "$where: '$value' is not a name: empty, or it holds a /"; return 1; } ;;
    no-new-privs-if-running)
      [[ $value =~ ^[0-9]+$ ]] || { warn "$where: $value is not a process id"; return 1; }
      [[ -e /proc/$value ]] || return 0
      meets no-new-privs "$value"
      ;;
    no-new-privs)
      [[ $value =~ ^[0-9]+$ && -r /proc/$value/status ]] || { warn "$where: cannot read the status of process $value"; return 1; }
      while IFS= read -r line; do
        [[ $line == NoNewPrivs:* ]] || continue
        [[ ${line//[[:space:]]/} == NoNewPrivs:1 ]] && return 0
        warn "$where: the tmux server (process $value) runs without no-new-privileges; it is refused"
        return 1
      done < "/proc/$value/status"
      warn "$where: process $value reports no NoNewPrivs line"
      return 1
      ;;
    *) warn "$where: the binding asks for an unknown test: $test"; return 1 ;;
  esac
}

seat_file() {
  local sum
  sum=$(printf '%s' "$1" | sha256sum) || return 1
  printf '%s\n' "$run_dir/seats/${sum%% *}.json"
}

save_seat() {
  local record=$1 name file
  name=$(jq -r '.name' <<< "$record") || return 1
  file=$(seat_file "$name") || return 1
  jq -c --slurpfile b "$build_dir/binding.json" '.inherit = $b[0].inherit' <<< "$record" > "$file"
}

apply_term() {
  local record=$1 term
  term=$(jq -c '.term' <<< "$record")
  where=$(jq -r '"\(.path), term \(.n) (\(.term | join(" ")))"' <<< "$record")
  if ! resolve_step call "$term" '[]'; then
    warn "$where: $(jq_message "$run_dir/step.err")"
    return 1
  fi
  local -a fields argv captured=()
  mapfile -d '' -t fields < "$run_dir/step"
  local next_state=${fields[1]} count=${fields[2]} i=3 k
  for (( k = 0; k < count; k++ )); do
    meets "${fields[i]}" "${fields[i + 1]}" || return 1
    i=$(( i + 2 ))
  done
  count=${fields[i]}
  i=$(( i + 1 ))
  argv=("${fields[@]:i:count}")
  i=$(( i + count ))
  local wanted=${fields[i]} seat=${fields[i + 1]} out=""
  state=$next_state
  if [[ -n $seat ]]; then
    save_seat "$seat" || { warn "$where: cannot record the seat"; return 1; }
  fi
  if (( ${#argv[@]} )); then
    log_call "${argv[@]}"
    if ! run_call out "${argv[@]}"; then
      warn "$where: ${argv[0]##*/} failed: $(jq_message "$run_dir/call.err")"
      return 1
    fi
  fi
  local caps_json='[]'
  if (( wanted )); then
    read -r -d "" -a captured <<< "$out" || :
    caps_json=$(json_list "${captured[@]}")
  fi
  if ! resolve_step after "$term" "$caps_json"; then
    warn "$where: $(jq_message "$run_dir/step.err")"
    return 1
  fi
  mapfile -d '' -t fields < "$run_dir/step"
  state=${fields[1]}
  [[ -n ${fields[2]} ]] && printf '%s\n' "${fields[2]}" >> "$run_dir/ledger"
  [[ -n ${fields[3]} ]] && printf '%s\n' "${fields[3]}" >> "$run_dir/checks"
  count=${fields[4]}
  i=5
  for (( k = 0; k < count; k++ )); do
    meets "${fields[i]}" "${fields[i + 1]}" || return 1
    i=$(( i + 2 ))
  done
  count=${fields[i]}
  i=$(( i + 1 ))
  local -a then_call=("${fields[@]:i:count}")
  if (( ${#then_call[@]} )); then
    log_call "${then_call[@]}"
    if ! run_call out "${then_call[@]}"; then
      warn "$where: ${then_call[0]##*/} failed: $(jq_message "$run_dir/call.err")"
      return 1
    fi
  fi
  return 0
}

name_an_empty_server() {
  local setpriv tmux server out
  local -a lines
  setpriv=$(jq -r '.slots[(["program", "setpriv"] | tojson)] // ""' <<< "$state")
  tmux=$(jq -r '.slots[(["program", "tmux"] | tojson)] // ""' <<< "$state")
  server=$(jq -r '.slots[(["server"] | tojson)] // ""' <<< "$state")
  [[ -n $setpriv && -n $tmux && -n $server ]] || return 0
  run_call out "$setpriv" --no-new-privs "$tmux" -L "$server" -u \
    list-sessions -F x \; show-options -sv exit-empty \; display-message -p '#{socket_path}' || return 0
  mapfile -t lines <<< "$out"
  (( ${#lines[@]} == 2 )) && [[ ${lines[0]} == off && -n ${lines[1]} ]] || return 0
  warn "the tmux server at ${lines[1]} is left running with no session, and the loop never ends a server; to end it: tmux -S ${lines[1]@Q} kill-server"
}

cmd_up() {
  (( $# == 0 )) || die "up takes no arguments" 2
  need_jq
  need_tmux
  locate
  verify_build || die "up starts only a verified build, and never builds"
  local view_file=/dev/null
  [[ -f $build_dir/plan-view.json ]] && view_file=$build_dir/plan-view.json
  plan_report "$build_dir/plan.json" "$build_dir/binding.json" "$build_dir/libexec/check.jq" "$view_file"
  need_programs "${plan_programs[@]}"
  mkdir -- "$run_dir" 2> /dev/null || die "the workplace is up already ($run_dir exists); run workplace down first"
  local run
  printf -v run 'workplace-%08x%08x' "$SRANDOM" "$SRANDOM"
  jq -c '.tables' <<< "$report" > "$run_dir/tables.json"
  mkdir -- "$run_dir/seats" || die "cannot make $run_dir/seats"
  state=$(jq -n -c --arg root "$root" --arg clone "$clone" --arg build "$build_dir" --arg run "$run" --arg bash "$BASH" \
    --argjson programs "$program_slots" \
    '{slots: ({(["root"] | tojson): $root, (["clone"] | tojson): $clone, (["build"] | tojson): $build,
               (["run"] | tojson): $run, (["bash"] | tojson): $bash} + $programs)}')
  : > "$run_dir/ledger"
  : > "$run_dir/checks"
  : > "$run_dir/calls.jsonl"
  local -a records
  local ordered
  ordered=$(jq -c --slurpfile b "$build_dir/binding.json" '
    $b[0].order as $order
    | [.programs[] | .path as $p | .plan | to_entries[]
       | {path: $p, n: (.key + 1), term: (.value | if type == "object" then .term else . end)}]
    | sort_by(.term[0] as $name | $order | index($name))[]' "$build_dir/plan.json") \
    || { rm -rf -- "$run_dir"; die "cannot order the plan's terms"; }
  mapfile -t records <<< "$ordered"
  if (( ${#records[@]} != plan_terms )); then
    rm -rf -- "$run_dir"
    die "the plan holds $plan_terms terms, and ${#records[@]} were ordered"
  fi
  local record applied=0
  for record in "${records[@]}"; do
    if ! apply_term "$record"; then
      teardown failed
      name_an_empty_server
      rm -rf -- "$run_dir"
      die "up stopped after $applied of ${#records[@]} terms; everything it made is torn down"
    fi
    applied=$(( applied + 1 ))
  done
  local leftover
  leftover=$(jq -r --slurpfile b "$build_dir/binding.json" \
    '[.slots | keys[] | fromjson | select(.[0] as $s | $b[0].spares | index($s)) | join("/")] | join(", ")' <<< "$state")
  if [[ -n $leftover ]]; then
    warn "a pane would stand that is not a seat: nothing claimed $leftover"
    teardown failed
    name_an_empty_server
    rm -rf -- "$run_dir"
    die "up stopped after $applied terms; everything it made is torn down"
  fi
  printf '%s\n' "$state" > "$run_dir/state.json"
  jq -n --argjson st "$state" \
    '[$st.slots | to_entries[] | {slot: (.key | fromjson), value: .value}]' > "$run_dir/slots.json"
  say "up: $applied terms applied; run $run"
}

cmd_exec() {
  local print=0
  if [[ ${1-} == --print ]]; then print=1; shift; fi
  [[ ${1-} == -- ]] && shift
  (( $# == 1 )) || die "exec takes a seat's name, with --print and -- before it" 2
  local seat=$1
  need_jq
  locate
  [[ -d $run_dir/seats ]] || die "nothing is up under $clone; exec starts a seat of a running workplace" 2
  verify_build || die "exec starts a seat only from a verified build" 2
  local record file
  file=$(seat_file "$seat") || die "cannot name the seat's record"
  [[ -f $file ]] || die "no seat is named $seat in this workplace" 2
  record=$(jq -c --arg n "$seat" 'select(.name == $n)' "$file") || die "cannot read $file"
  [[ -n $record ]] || die "the record at $file is not the seat $seat's" 2
  local -a inherit pairs command assignments=()
  mapfile -t inherit < <(jq -r '.inherit[]' <<< "$record")
  local name directory
  directory=$(jq -r '.directory' <<< "$record")
  PWD=$directory
  for name in "${inherit[@]}"; do
    [[ -n ${!name+x} ]] && assignments+=("$name=${!name}")
  done
  mapfile -d '' -t pairs < <(jq --raw-output0 '.environment[] | "\(.[0])=\(.[1])"' <<< "$record")
  assignments+=("${pairs[@]}")
  mapfile -d '' -t command < <(jq --raw-output0 '.command[]' <<< "$record")
  local env_program
  env_program=$(command -v env) || die "exec needs env, and env is not on PATH" 2
  local -a argv=("$env_program" -i "${assignments[@]}" "${command[@]}")
  if (( print )); then
    json_list "${argv[@]}"
    return 0
  fi
  cd -- "$directory" || die "cannot enter $directory" 2
  exec "${argv[@]}"
}

cmd_why() {
  (( $# == 2 )) || die "why takes a seat's name and an absolute path" 2
  local seat=$1 path=$2
  [[ $path == /* ]] || die "why takes an absolute path, not $path" 2
  need_jq
  locate
  local plan=$plan_dir/plan.json binding=$tool/host/binding.json view=$plan_dir/view.json lib=$tool/libexec
  if [[ -f $build_dir/plan.json ]]; then
    plan=$build_dir/plan.json binding=$build_dir/binding.json view=$build_dir/plan-view.json lib=$build_dir/libexec
  fi
  [[ -f $plan ]] || die "no plan in $plan_dir" 2
  [[ -f $view ]] || view=/dev/null
  jq -r -L "$lib" --arg seat "$seat" --arg path "$path" --slurpfile b "$binding" --slurpfile folded "$view" -f /dev/stdin "$plan" <<'JQ'
    include "table";
    . as $plan
    | $b[0].tables.view as $spec
    | def term: if type == "object" and .unchecked == true then .term else . end;
      def beneath($p; $q): ($q == "/" and $p != "/") or ($p | startswith($q + "/"));
      def at($o): "\($o.path // "?"):\($o.line // "?")";
      def said($s): "\($s.term[4]) \([$s.term[1:4][] | select(. != "-")] | join("/") | if . == "" then "" else . + " " end)\($s.term[5]) \($s.term[6]), from \([$s.origins[] | at(.)] | join(", "))";
      [.programs[].plan[] | term | select(.[0] == "pane" and .[4] == $seat) | .[1:4]] as $keys
      | if ($keys | length) != 1 then "no seat is named \($seat) in this plan"
        elif folded($plan; $spec) and $folded[0] == null then
          "the plan holds statements, clearances or labels, and its folded view is missing"
        else
          $keys[0] as $k
          | [table_rows($plan; $folded[0]; $spec)[] | select(.key[0:3] == $k)] as $rows
          | ([$rows[] | select(.key[3] == $path or beneath($path; .key[3]))] | sort_by(.key[3] | length) | last) as $row
          | "seat \($seat) (\($k | join("/"))), path \($path)",
            (if ($rows | length) == 0 then "no view: the seat sees the machine as its user does"
             elif $row == null then "no row covers the path"
             elif $row.key[3] == $path then "row: \($path) \($row.value[0])"
             else "no row at the path; its nearest ancestor's row is \($row.key[3]) \($row.value[0])" end),
            (if $row == null then empty
             elif ($row | has("source")) then
               "made by a \($row.source), from \([$row.origins[] | at(.)] | join(", "))",
               ([$folded[0].seats[] | select(.seat == $k) | .replacement_statements[] | select(.statement.term[5] == $row.key[3])] as $replacing
                | if ($replacing | length) == 0 then empty
                  else "it replaced \($replacing[0].replaced | length):", ($replacing[0].replaced[] | "  \(said(.))") end)
             else
               [$plan.programs[] | .path as $file | (.recorded // [])[]
                | select(.term[0] == $spec.claims.term)
                | select([.term[$spec.claims.key[]]] == ($k + [$row.key[3]]))
                | "  \(.term[$spec.claims.value])  from \(.origin.path // $file):\(.origin.line // "?")"] as $claims
               | "claims behind \($row.key[3]): \($claims | length)", $claims[]
             end)
        end
JQ
}

cmd_doctor() {
  (( $# == 0 )) || die "doctor takes no arguments" 2
  local bad=0 program found
  if (( BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 2) )); then
    say "ok      bash $BASH_VERSION"
  else
    say "old     bash $BASH_VERSION; 5.2 or later is needed"
    bad=1
  fi
  local spec version
  for spec in "jq --version $JQ_FLOOR" "tmux -V $TMUX_FLOOR"; do
    set -- $spec
    if ! command -v "$1" > /dev/null; then say "missing $1"; bad=1; continue; fi
    if version=$(version_of "$1" "$2"); then
      if at_least "$version" "$3"; then say "ok      $1 $version"; else say "old     $1 $version; $3 or later is needed"; bad=1; fi
    else
      say "unknown $1: its version cannot be read"
      bad=1
    fi
  done
  for program in setpriv env mkdir cp rm sha256sum stat; do
    if found=$(command -v "$program"); then
      version=$(version_of "$found" --version) || version="version unknown"
      say "ok      $program $version $found"
    else
      say "missing $program"
      bad=1
    fi
  done
  if [[ -r /proc/sys/dev/tty/legacy_tiocsti ]]; then
    if [[ $(< /proc/sys/dev/tty/legacy_tiocsti) == 0 ]]; then
      say "ok      TIOCSTI is off: a seat started by hand cannot push input into the terminal that started it"
    else
      say "note    TIOCSTI is on: a seat started by hand with exec can push input into the terminal that started it"
    fi
  else
    say "note    the kernel does not say whether TIOCSTI is on"
  fi
  if found=$(command -v setpriv) && "$found" --no-new-privs true 2> /dev/null; then
    say "ok      no-new-privileges can be set"
  else
    say "missing no-new-privileges: setpriv --no-new-privs fails"
    bad=1
  fi
  if found=$(command -v bwrap); then
    if "$found" --unshare-user --unshare-pid --ro-bind / / -- true 2> /dev/null; then
      say "ok      bwrap $found, with unprivileged user namespaces"
    else
      say "refused bwrap cannot make a user namespace on this host"
      local step=""
      [[ -r /proc/sys/kernel/apparmor_restrict_unprivileged_userns && $(< /proc/sys/kernel/apparmor_restrict_unprivileged_userns) == 1 ]] \
        && step="sysctl -w kernel.apparmor_restrict_unprivileged_userns=0"
      [[ -r /proc/sys/kernel/unprivileged_userns_clone && $(< /proc/sys/kernel/unprivileged_userns_clone) == 0 ]] \
        && step="sysctl -w kernel.unprivileged_userns_clone=1"
      [[ -r /proc/sys/user/max_user_namespaces && $(< /proc/sys/user/max_user_namespaces) == 0 ]] \
        && step="sysctl -w user.max_user_namespaces=15000"
      say "        the host's one root step, which the workplace never takes: ${step:-unknown on this host}"
      bad=1
    fi
  else
    say "absent  bwrap: needed only by a plan in which a seat has a view"
  fi
  return "$bad"
}

same_socket() {
  local recorded label here
  recorded=$(jq -r '.slots[(["socket"] | tojson)] // empty' "$run_dir/state.json" 2> /dev/null)
  label=$(jq -r '.slots[(["server"] | tojson)] // empty' "$run_dir/state.json" 2> /dev/null)
  [[ -n $recorded && -n $label ]] || { warn "the run's record names no server socket"; return 1; }
  local dir=${TMUX_TMPDIR:-/tmp}/tmux-$UID there
  here=$(cd -P -- "$dir" 2> /dev/null && pwd -P) || here=$dir
  here=$here/$label
  there=$(cd -P -- "${recorded%/*}" 2> /dev/null && pwd -P) || there=${recorded%/*}
  there=$there/${recorded##*/}
  [[ $here == "$there" ]] && return 0
  warn "this run's server listens at $recorded, and tmux from this shell would reach $here; run it with the TMUX_TMPDIR of up"
  return 1
}

cmd_down() {
  (( $# == 0 )) || die "down takes no arguments" 2
  need_jq
  need_tmux
  locate
  if [[ ! -d $run_dir ]]; then
    say "down: nothing is up under $clone"
    return 0
  fi
  [[ -f $run_dir/state.json ]] || die "the run under $run_dir did not finish up; remove $run_dir by hand after checking its server" 2
  same_socket || die "down refuses, and keeps $run_dir" 2
  teardown down
  if (( undo_failed )); then
    die "an undo failed; $run_dir is kept"
  fi
  rm -rf -- "$run_dir"
  say "down: done"
}

cmd_status() {
  (( $# == 0 )) || die "status takes no arguments" 2
  need_jq
  locate
  local bad=0 sum
  if [[ ! -d $build_dir ]]; then
    say "build: none"
  elif verify_build; then
    sum=$(sha_of "$build_dir/MANIFEST")
    say "build: verified, manifest $sum"
  else
    say "build: does not match its manifest"
    bad=1
  fi
  if [[ ! -d $run_dir ]]; then
    say "run: down"
    return "$bad"
  fi
  need_tmux
  same_socket || return 2
  local run
  run=$(jq -r '.slots[(["run"] | tojson)] // "unknown"' "$run_dir/state.json" 2> /dev/null) || run=unknown
  say "run: up, $run"
  local -a records fields call
  local record what is out
  mapfile -t records < "$run_dir/checks"
  for record in "${records[@]}"; do
    mapfile -d '' -t fields < <(jq --raw-output0 '.what, (.is // ""), .call[]' <<< "$record")
    what=${fields[0]}
    is=${fields[1]}
    call=("${fields[@]:2}")
    if run_call out "${call[@]}" && [[ $out == "$is" ]]; then
      say "ok      $what"
    else
      say "gone    $what"
      bad=1
    fi
  done
  return "$bad"
}

usage() {
  say "usage: workplace plan | build | up | exec [--print] SEAT | down | status | why SEAT PATH | doctor"
  say "reads WORKPLACE_ROOT and WORKPLACE_CONFIG"
}

(( $# )) || { usage >&2; exit 2; }
command=$1
shift
case $command in
  plan) cmd_plan "$@" ;;
  build) cmd_build "$@" ;;
  up) cmd_up "$@" ;;
  exec) cmd_exec "$@" ;;
  down) cmd_down "$@" ;;
  status | doctor)
    "cmd_$command" "$@"
    exit $?
    ;;
  why) cmd_why "$@" ;;
  help | --help | -h) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
