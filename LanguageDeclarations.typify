#lang typify
declare : Structure
version : 1
file : programs/STRUCTURE.typify
required!
is : office-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : room-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : seat-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : display-name = /[A-Za-z0-9][A-Za-z0-9 _-]*/
is : layout = "even-horizontal" | "even-vertical" | "main-horizontal" | "main-vertical" | "tiled"
cell : sessions = shadow
primitive : session : office-key display-name
writes : session : sessions = put 1
stage : session = 10
cell : windows = shadow
primitive : window : office-key room-key display-name
writes : window : windows = put 2
stage : window = 20
cell : panes = shadow
primitive : pane : office-key room-key seat-key display-name
writes : pane : panes = put 3
stage : pane = 30
cell : arrangements = shadow
primitive : arrange : office-key room-key layout
writes : arrange : arrangements = put 2
stage : arrange = 40
term : office : office-key display-name
rule : office <o> <n> -> session <o> <n>
form : office : <office-key> = <display-name>
does : office <office-key> <display-name>
count : office = 1..*
count : office = 0..1 by 1
term : room : office-key room-key display-name layout
rule : room <o> <r> <n> <l> -> window <o> <r> <n> ; arrange <o> <r> <l>
form : room : <office-key> / <room-key> = <display-name> : <layout>
does : room <office-key> <room-key> <display-name> <layout>
count : room = 1..*
count : room = 0..1 by 2
ensure : room : office-declared = (bound sessions <1>)
term : seat : display-name office-key room-key seat-key
rule : seat <n> <o> <r> <s> -> pane <o> <r> <s> <n>
form : seat : <display-name> = <office-key> / <room-key> / <seat-key>
does : seat <display-name> <office-key> <room-key> <seat-key>
count : seat = 1..*
count : seat = 0..1 by 1
ensure : seat : room-declared = (bound windows <2> <3>)
end!
declare : WorkplaceAccess
version : 1
file : programs/WORKPLACE.typify
optional!
is : workplace-path = canonical-path | relative-path | "."
is : mode = "hidden" | "searchable-only" | "scratch" | "read-only" | "read-write"
is : clearance-number = /(0|[1-9][0-9]*)/
cell : statement-records = shadow
primitive : statement : text text text text workplace-path mode
writes : statement : statement-records = put 5
effect : statement = state
cell : label-records = shadow
primitive : label : workplace-path clearance-number
writes : label : label-records = put 1
effect : label = state
form : view : <workplace-path> = <mode>
does : statement - - - workplace <workplace-path> <mode>
form : label : <workplace-path> = <clearance-number>
does : label <workplace-path> <clearance-number>
end!

declare : OfficeAccess
version : 1
file : programs/OFFICE[<office-key>]/OFFICE.typify
optional!
is : workplace-path = canonical-path | relative-path | "."
is : office-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : mode = "hidden" | "searchable-only" | "scratch" | "read-only" | "read-write"
is : clearance-number = /(0|[1-9][0-9]*)/
cell : sessions = shadow
cell : statement-records = shadow
primitive : statement : text text text text workplace-path mode
writes : statement : statement-records = put 5
effect : statement = state
ensure : statement : office-declared = (bound sessions <office-key>)
cell : clearance-records = shadow
primitive : clearance : text text text text clearance-number
writes : clearance : clearance-records = put 4
effect : clearance = state
ensure : clearance : office-declared = (bound sessions <office-key>)
form : view : <workplace-path> = <mode>
does : statement <office-key> - - office <workplace-path> <mode>
form : clearance : <clearance-number>
does : clearance <office-key> - - office <clearance-number>
end!

declare : RoomAccess
version : 1
file : programs/OFFICE[<office-key>]/ROOM[<room-key>]/ROOM.typify
optional!
is : workplace-path = canonical-path | relative-path | "."
is : office-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : room-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : mode = "hidden" | "searchable-only" | "scratch" | "read-only" | "read-write"
is : clearance-number = /(0|[1-9][0-9]*)/
cell : windows = shadow
cell : statement-records = shadow
primitive : statement : text text text text workplace-path mode
writes : statement : statement-records = put 5
effect : statement = state
ensure : statement : room-declared = (bound windows <office-key> <room-key>)
cell : clearance-records = shadow
primitive : clearance : text text text text clearance-number
writes : clearance : clearance-records = put 4
effect : clearance = state
ensure : clearance : room-declared = (bound windows <office-key> <room-key>)
form : view : <workplace-path> = <mode>
does : statement <office-key> <room-key> - room <workplace-path> <mode>
form : clearance : <clearance-number>
does : clearance <office-key> <room-key> - room <clearance-number>
end!

declare : SeatAccess
version : 1
file : programs/OFFICE[<office-key>]/ROOM[<room-key>]/SEAT[<seat-key>]/SEAT.typify
optional!
is : workplace-path = canonical-path | relative-path | "."
is : office-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : room-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : seat-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : mode = "hidden" | "searchable-only" | "scratch" | "read-only" | "read-write"
is : clearance-number = /(0|[1-9][0-9]*)/
cell : panes = shadow
cell : statement-records = shadow
primitive : statement : text text text text workplace-path mode
writes : statement : statement-records = put 5
effect : statement = state
ensure : statement : seat-declared = (bound panes <office-key> <room-key> <seat-key>)
cell : clearance-records = shadow
primitive : clearance : text text text text clearance-number
writes : clearance : clearance-records = put 4
effect : clearance = state
ensure : clearance : seat-declared = (bound panes <office-key> <room-key> <seat-key>)
form : view : <workplace-path> = <mode>
does : statement <office-key> <room-key> <seat-key> seat <workplace-path> <mode>
form : clearance : <clearance-number>
does : clearance <office-key> <room-key> <seat-key> seat <clearance-number>
end!
declare : AgentKinds
version : 1
file : programs/KINDS.typify
optional!
is : kind-key = /[A-Za-z0-9][A-Za-z0-9_-]*/ except "none"
cell : kinds = shadow
primitive : declare-kind : kind-key
writes : declare-kind : kinds = put 1 "declared"
effect : declare-kind = state
form : kind : <kind-key>
does : declare-kind <kind-key>
count : declare-kind = 0..1 by 1
end!

declare : KindAccess
version : 1
file : programs/KIND[<kind-key>]/KIND.typify
optional!
is : workplace-path = canonical-path | relative-path | "."
is : kind-key = /[A-Za-z0-9][A-Za-z0-9_-]*/ except "none"
is : mode = "hidden" | "searchable-only" | "scratch" | "read-only" | "read-write"
cell : kinds = shadow
cell : statement-records = shadow
primitive : statement : text text text text workplace-path mode
writes : statement : statement-records = put 5
effect : statement = state
ensure : statement : kind-declared = (bound kinds <kind-key>)
form : view : <workplace-path> = <mode>
does : statement <kind-key> - - kind <workplace-path> <mode>
end!

declare : Directories
version : 1
file : programs/OFFICE[<office-key>]/ROOM[<room-key>]/SEAT[<seat-key>]/DIRECTORIES.typify
required!
is : workplace-path = canonical-path | relative-path | "."
is : office-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : room-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : seat-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : kind = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : kind-key = /[A-Za-z0-9][A-Za-z0-9_-]*/ except "none"
cell : kinds = shadow
cell : named-selections = shadow
cell : none-selections = shadow
primitive : mark-named : office-key room-key seat-key
writes : mark-named : named-selections = put 3 "selected"
effect : mark-named = state
primitive : mark-none : office-key room-key seat-key
writes : mark-none : none-selections = put 3 "selected"
effect : mark-none = state
cell : panes = shadow
cell : directories = shadow
primitive : record-directory : office-key room-key seat-key workplace-path
writes : record-directory : directories = put 4 "declared"
effect : record-directory = state
cell : seat-kinds = shadow
primitive : assign-kind : office-key room-key seat-key kind
writes : assign-kind : seat-kinds = put 3
effect : assign-kind = state
term : directory : workplace-path
rule : directory <p> -> record-directory <office-key> <room-key> <seat-key> <p>
ensure : directory : declared-seat = (bound panes <office-key> <room-key> <seat-key>)
ensure : directory : kind-selected = (bound seat-kinds <office-key> <room-key> <seat-key>)
form : directory : <workplace-path>
does : directory <workplace-path>
count : directory = 1..*
count : directory = 0..1 by 1
term : select-none : kind
rule : select-none <k> -> assign-kind <office-key> <room-key> <seat-key> <k> ; mark-none <office-key> <room-key> <seat-key>
ensure : select-none : no-named-kind = (absent named-selections <office-key> <room-key> <seat-key>)
form : agent : none
does : select-none none
count : select-none = 0..1
term : select-kind : kind-key
rule : select-kind <k> -> assign-kind <office-key> <room-key> <seat-key> <k> ; mark-named <office-key> <room-key> <seat-key>
ensure : select-kind : kind-declared = (bound kinds <1>)
ensure : select-kind : no-none-kind = (absent none-selections <office-key> <room-key> <seat-key>)
form : agent : <kind-key>
does : select-kind <kind-key>
count : select-kind = 0..1
end!

declare : SeatEnvironment
version : 1
file : programs/OFFICE[<office-key>]/ROOM[<room-key>]/SEAT[<seat-key>]/ENVIRONMENT.typify
optional!
is : office-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : room-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : seat-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : variable = /[A-Za-z_][A-Za-z0-9_]*/
cell : panes = shadow
cell : environment = shadow
primitive : set-environment : office-key room-key seat-key variable text
writes : set-environment : environment = put 4
effect : set-environment = state
term : environment : variable text
rule : environment <n> <v> -> set-environment <office-key> <room-key> <seat-key> <n> <v>
ensure : environment : declared-seat = (bound panes <office-key> <room-key> <seat-key>)
form : environment : <variable> = <text>
does : environment <variable> <text>
count : environment = 0..1 by 1
end!
declare : Host
version : 1
file : ROOT.typify
required!
is : workplace-path = canonical-path | relative-path | "."
is : workplace = /[A-Za-z0-9][A-Za-z0-9_-]*/
cell : configuration = shadow
primitive : configure : text text
writes : configure : configuration = put 1
effect : configure = state
term : workdir : canonical-path
rule : workdir <p> -> configure root <p>
form : workdir : <canonical-path>
does : workdir <canonical-path>
count : workdir = 1
primitive : server : workplace workplace-path
effect : server = external
stage : server = 0
form : server : <workplace> : <workplace-path>
does : server <workplace> <workplace-path>
count : server = 1
end!

declare : WorkplaceEnvironment
version : 1
file : programs/ENVIRONMENT.typify
optional!
is : office-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : room-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : seat-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : variable = /[A-Za-z_][A-Za-z0-9_]*/
cell : environment = shadow
primitive : set-environment : office-key room-key seat-key variable text
writes : set-environment : environment = put 4
effect : set-environment = state
form : environment : <office-key>/<room-key>/<seat-key> : <variable> = <text>
does : set-environment <office-key> <room-key> <seat-key> <variable> <text>
end!

declare : Start
version : 1
file : programs/OFFICE[<office-key>]/ROOM[<room-key>]/SEAT[<seat-key>]/run/START.typify
required!
is : workplace-path = canonical-path | relative-path | "."
is : office-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : room-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : seat-key = /[A-Za-z0-9][A-Za-z0-9_-]*/
is : argv = /\[.+\]/
cell : panes = shadow
primitive : start : office-key room-key seat-key workplace-path argv
effect : start = external
stage : start = 50
form : command : <argv>
does : start <office-key> <room-key> <seat-key> (context Directories.directory) <argv>
count : start = 1
ensure : start : seat-declared = (bound panes <office-key> <room-key> <seat-key>)
end!
