#!/usr/bin/env bash
shopt -s nullglob dotglob
name=$1
shift
report=""
say() {
  printf '%s\n' "$*"
  [[ -n $report ]] && printf '%s\n' "$*" >> "$report"
}
pause() { read -r -t "$1" _ <> <(:) || :; }
term_checks() {
  local file=$1 other="" i
  for (( i = 0; i < 200; i++ )); do
    [[ -s $file ]] && break
    pause 0.05
  done
  IFS= read -r other < "$file" || :
  if exec 3<> /dev/tty; then say "term /dev/tty: open"; exec 3>&-; else say "term /dev/tty: refused"; fi
  if stty size > /dev/null 2>&1; then say "term stty: ok"; else say "term stty: refused"; fi
  set -m
  pause 2 &
  local job=$!
  kill -STOP "$job" 2> /dev/null
  pause 0.2
  if [[ $(jobs -l) == *Stopped* ]]; then say "term job stopped: yes"; else say "term job stopped: no"; fi
  kill -CONT "$job" 2> /dev/null
  if fg %1 > /dev/null 2>&1; then say "term fg: ok"; else say "term fg: refused"; fi
  set +m
  if [[ -n $other ]] && { printf '%s' 'other-pane-write-mark' > "$other"; } 2> /dev/null; then say "term other pane: written"; else say "term other pane: refused"; fi
}
term_file=""
typed_file=""
box=""
await_answer() {
  local i
  for (( i = 0; i < 400; i++ )); do
    [[ -f $box/answers/$1 ]] && return 0
    pause 0.05
  done
  return 1
}
say "probe $name start cwd=$PWD"
for argument in "$@"; do
  case $argument in
    report=*) report=${argument#report=}; : > "$report" ;;
    hidden=*)
      place=${argument#hidden=}
      listing=("$place"/*)
      if [[ -e $place/secret ]] || (( ${#listing[@]} )); then seen=seen; else seen=unseen; fi
      say "hidden $place: $seen"
      ;;
    ro=*)
      place=${argument#ro=}
      if IFS= read -r line < "$place/page" 2> /dev/null; then got=ok; else got=refused; fi
      if { printf '%s\n' "$name" > "$place/probe-$name"; } 2> /dev/null; then put=ok; rm -f -- "$place/probe-$name"; else put=refused; fi
      say "ro $place: read=$got write=$put"
      ;;
    rw=*)
      place=${argument#rw=}
      if { printf '%s\n' "$name" > "$place/probe-$name"; } 2> /dev/null; then put=ok; rm -f -- "$place/probe-$name"; else put=refused; fi
      say "rw $place: write=$put"
      say "where $place: $(stat -L -c %d:%i -- "$place" 2> /dev/null)"
      ;;
    reach=*)
      place=${argument#reach=}
      if { printf '%s\n' "$name" > "$place/probe-$name"; } 2> /dev/null; then put=ok; rm -f -- "$place/probe-$name"; else put=refused; fi
      say "reach $place: write=$put"
      ;;
    list=*)
      place=${argument#list=}
      if [[ -r $place ]]; then got=ok; else got=refused; fi
      say "list $place: $got"
      ;;
    scratch=*)
      place=${argument#scratch=}
      listing=("$place"/*)
      if { printf '%s\n' "$name" > "$place/probe-$name"; } 2> /dev/null; then put=ok; rm -f -- "$place/probe-$name"; else put=refused; fi
      say "scratch $place: entries=${#listing[@]} write=$put"
      say "where $place: $(stat -L -c %d:%i -- "$place" 2> /dev/null)"
      ;;
    env)
      mapfile -d '' -t entries < /proc/self/environ
      names=()
      for entry in "${entries[@]}"; do names+=("${entry%%=*}"); done
      mapfile -t names < <(printf '%s\n' "${names[@]}" | sort)
      say "env ${names[*]}"
      ;;
    value=*)
      variable=${argument#value=}
      say "value $variable=${!variable-unset}"
      ;;
    secret=*)
      variable=${argument#secret=}
      if [[ -n ${!variable+x} ]]; then
        sum=$(printf '%s' "${!variable}" | sha256sum)
        say "secret $variable: sha256 ${sum%% *}"
      else
        say "secret $variable: unset"
      fi
      ;;
    home=*)
      variable=${argument#home=}
      place=${!variable-}
      if [[ -z $place ]]; then
        say "home $variable: unset"
      else
        say "home $variable: $place"
        printf '%s\n' "$name" >> "$place/starts" 2> /dev/null && got=ok || got=refused
        say "home write: $got"
        say "home starts: $(grep -c '' "$place/starts" 2> /dev/null)"
        say "home fs: $(stat -f -c %T -- "$place" 2> /dev/null)"
        say "home where: $(stat -L -c %d:%i -- "$place" 2> /dev/null)"
        if [[ $(stat -c %d -- "$place" 2> /dev/null) != "$(stat -c %d -- "${place%/*}" 2> /dev/null)" ]]; then got=yes; else got=no; fi
        say "home own file system: $got"
        say "home mode: $(stat -c %a -- "$place" 2> /dev/null)"
        listing=("$place"/*)
        say "home entries: $(for entry in "${listing[@]}"; do printf '%s\n' "${entry##*/}"; done | LC_ALL=C sort | tr '\n' ' ')"
        listing=("${place%/*}"/*)
        say "home siblings: $(for entry in "${listing[@]}"; do printf '%s\n' "${entry##*/}"; done | LC_ALL=C sort | tr '\n' ' ')"
        listing=("${place%/homes/*}"/*)
        say "home state: $(for entry in "${listing[@]}"; do printf '%s\n' "${entry##*/}"; done | LC_ALL=C sort | tr '\n' ' ')"
        listing=("${place%/homes/*}"/homes/*)
        say "home kinds: $(for entry in "${listing[@]}"; do printf '%s\n' "${entry##*/}"; done | LC_ALL=C sort | tr '\n' ' ')"
        if [[ -f $place/seeded ]]; then say "home seeded: $(tr '\n' ' ' < "$place/seeded")"; else say "home seeded: no"; fi
      fi
      ;;
    pid)
      procs=(/proc/[0-9]*)
      say "pid $$ procs ${#procs[@]}"
      ;;
    ns) say "ns ipc $(stat -L -c %i /proc/self/ns/ipc) pid $(stat -L -c %i /proc/self/ns/pid)" ;;
    identity=*)
      place=${argument#identity=}
      if [[ -z ${GNUPGHOME-} ]]; then
        say "key home: none"
      else
        listing=("$GNUPGHOME"/*)
        say "key home: $(for entry in "${listing[@]}"; do printf '%s\n' "${entry##*/}"; done | LC_ALL=C sort | tr '\n' ' ')"
        if { : > "$GNUPGHOME/probe-$name"; } 2> /dev/null; then put=ok; rm -f -- "$GNUPGHOME/probe-$name"; else put=refused; fi
        say "key home write: $put"
        listing=("${GNUPGHOME%/*}"/*)
        say "key state: $(for entry in "${listing[@]}"; do printf '%s\n' "${entry##*/}"; done | LC_ALL=C sort | tr '\n' ' ')"
        printf '%s\n' 'a line to sign' > "$place/msg"
        if gpg --batch --detach-sign --armor -o "$place/msg.asc" "$place/msg" 2> /dev/null; then got=ok; else got=failed; fi
        say "key gpg sign: $got"
        say "key export: $(gpg --batch --export-secret-keys 2> /dev/null | wc -c) bytes"
        say "key export loopback: $(gpg --batch --pinentry-mode loopback --passphrase '' --export-secret-keys 2> /dev/null | wc -c) bytes"
        say "key export subkeys: $(gpg --batch --export-secret-subkeys 2> /dev/null | wc -c) bytes"
        forbidden=0 total=0
        while IFS=: read -r kind _ _ _ _ _ _ _ _ grip _; do
          [[ $kind == grp ]] || continue
          for command in "READKEY $grip" "EXPORT_KEY $grip" "EXPORT_KEY --openpgp $grip" "DELETE_KEY --force $grip" "PASSWD $grip" "KEYATTR $grip Use-for-ssh: false"; do
            total=$(( total + 1 ))
            [[ $(gpg-connect-agent --no-autostart "$command" /bye 2>&1) == *Forbidden* ]] && forbidden=$(( forbidden + 1 ))
          done
        done < <(gpg --with-colons --with-keygrip --list-keys 2> /dev/null)
        for command in "KEYWRAP_KEY --export" "IMPORT_KEY" "PRESET_PASSPHRASE 0000000000000000000000000000000000000000 -1 41" "GETINFO pid" "RELOADAGENT" "KILLAGENT"; do
          total=$(( total + 1 ))
          [[ $(gpg-connect-agent --no-autostart "$command" /bye 2>&1) == *Forbidden* ]] && forbidden=$(( forbidden + 1 ))
        done
        say "key agent: $forbidden of $total forbidden"
        if gpg --batch --detach-sign -o "$place/msg2.sig" "$place/msg" 2> /dev/null; then got=ok; else got=failed; fi
        say "key gpg sign after: $got"
        ssh-add -L > "$place/seat.pub" 2> /dev/null
        read -r kind blob _ < "$place/seat.pub"
        say "key ssh list: $kind $blob"
        if ssh-keygen -Y sign -f "$place/seat.pub" -n file "$place/msg" > /dev/null 2>&1; then got=ok; else got=failed; fi
        say "key ssh sign: $got"
        ssh-add -D > /dev/null 2>&1
        read -r kind2 blob2 _ < <(ssh-add -L 2> /dev/null)
        if [[ "$kind2 $blob2" == "$kind $blob" ]]; then got=listed; else got=gone; fi
        say "key ssh after removing all: $got"
        rm -f -- "$place/new" "$place/new.pub"
        if ssh-keygen -q -t ed25519 -N '' -f "$place/new" < /dev/null > /dev/null 2>&1 && ssh-add "$place/new" > /dev/null 2>&1; then got=added; else got=refused; fi
        rm -f -- "$place/new" "$place/new.pub"
        say "key ssh add: $got"
        fpr=$(gpg --with-colons --list-keys 2> /dev/null | awk -F: '$1 == "fpr" { print $10; exit }')
        say "key ssh forged add of the signing key: $(python3 -I "${0%/*}/forge" "$SSH_AUTH_SOCK" "$(gpg --export-ssh-key "$fpr!" 2> /dev/null)" 17 2>&1)"
        say "key ssh forged add of its own key, confirmed: $(python3 -I "${0%/*}/forge" "$SSH_AUTH_SOCK" "$kind $blob" 25 2>&1)"
        say "key ssh list after forged adds: $(ssh-add -L 2> /dev/null | cut -d' ' -f1,2 | paste -sd'|')"
        printf '%s\n' 'a line to sign after' > "$place/msg3"
        if ssh-keygen -Y sign -f "$place/seat.pub" -n file "$place/msg3" > /dev/null 2>&1; then got=ok; else got=failed; fi
        say "key ssh sign after forged adds: $got"
      fi
      listing=("/run/user/$EUID/gnupg"/*)
      if [[ -r /run/user/$EUID/gnupg ]] && (( ${#listing[@]} )); then got=seen; else got=unseen; fi
      say "key runtime sockets: $got"
      ;;
    commit=*)
      spec=${argument#commit=}
      place=${spec%%|*}
      rest=${spec#*|}
      if git init -q "$place/repo" 2> /dev/null \
        && git -C "$place/repo" -c user.name="${rest%%|*}" -c user.email="${rest#*|}" commit -q -S --allow-empty -m 'signed in the pane' > "$place/commit.out" 2>&1
      then got=ok; else got=failed; fi
      say "key commit: $got"
      ;;
    term=*) term_file=${argument#term=} ;;
    typed=*) typed_file=${argument#typed=} ;;
    print=*) cat -- "${argument#print=}" ;;
    wait=*)
      for (( i = 0; i < 200; i++ )); do [[ -e ${argument#wait=} ]] && break; pause 0.05; done
      ;;
    tamper=*)
      place=${argument#tamper=}
      if { printf x >> "$place"; } 2> /dev/null; then a=done; else a=refused; fi
      if { : > "$place"; } 2> /dev/null; then t=done; else t=refused; fi
      if mv -- "$place" "$place.moved" 2> /dev/null; then m=done; else m=refused; fi
      if rm -f -- "$place" 2> /dev/null && [[ ! -e $place ]]; then r=done; else r=refused; fi
      if { : > "${place%/*}/made-by-$name"; } 2> /dev/null; then c=done; else c=refused; fi
      say "tamper $place: append=$a truncate=$t rename=$m remove=$r make=$c"
      ;;
    socket=*)
      place=${argument#socket=}
      if tmux -S "$place" list-sessions > /dev/null 2>&1; then got=answered; else got=refused; fi
      say "socket $place: $got"
      ;;
    connect=*)
      place=${argument#connect=}
      if [[ ! -e $place ]]; then got=absent
      elif python3 -I -c 'import socket, sys; s = socket.socket(socket.AF_UNIX); s.settimeout(5); s.connect(sys.argv[1])' "$place" 2> /dev/null; then got=connected
      else got=refused; fi
      say "connect $place: $got"
      ;;
    bus=*)
      place=${argument#bus=}
      if timeout 10 busctl --address="unix:path=$place" call org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.DBus.Properties Get ss org.freedesktop.systemd1.Manager Version > /dev/null 2>&1; then got=answered; else got=refused; fi
      say "bus $place: $got"
      ;;
    entries=*)
      place=${argument#entries=}
      listing=("$place"/*)
      if [[ -d $place ]]; then say "entries $place: $(for entry in "${listing[@]}"; do printf '%s\n' "${entry##*/}"; done | LC_ALL=C sort | tr '\n' ' ')"
      else say "entries $place: none"; fi
      ;;
    box=*)
      box=${argument#box=}
      for place in out in sent answers .; do
        if { printf '%s\n' "$name" > "$box/$place/.probe-$name"; } 2> /dev/null; then put=ok; rm -f -- "$box/$place/.probe-$name"; else put=refused; fi
        say "box $place: write=$put"
      done
      listing=("$box"/*)
      say "box entries: $(for entry in "${listing[@]}"; do printf '%s\n' "${entry##*/}"; done | LC_ALL=C sort | tr '\n' ' ')"
      ;;
    post=*)
      spec=${argument#post=}
      if cp -- "${spec#*:}" "$box/out/.${spec%%:*}" 2> /dev/null && mv -- "$box/out/.${spec%%:*}" "$box/out/${spec%%:*}" 2> /dev/null
      then say "post ${spec%%:*}: ok"; else say "post ${spec%%:*}: refused"; fi
      ;;
    link=*)
      spec=${argument#link=}
      if ln -s -- "${spec#*:}" "$box/out/${spec%%:*}" 2> /dev/null; then say "link ${spec%%:*}: ok"; else say "link ${spec%%:*}: refused"; fi
      ;;
    node=*)
      spec=${argument#node=}
      case ${spec#*:} in
        dir) mkdir -- "$box/out/${spec%%:*}" && printf '%s\n' inside > "$box/out/${spec%%:*}/inside" ;;
        fifo) mkfifo -- "$box/out/${spec%%:*}" ;;
        socket) python3 -c 'import socket, sys; socket.socket(socket.AF_UNIX).bind(sys.argv[1])' "$box/out/${spec%%:*}" ;;
      esac 2> /dev/null
      if [[ -e $box/out/${spec%%:*} ]]; then say "node ${spec%%:*}: $(stat -c %F -- "$box/out/${spec%%:*}")"; else say "node ${spec%%:*}: refused"; fi
      ;;
    answer=*)
      spec=${argument#answer=}
      if await_answer "$spec"; then IFS= read -r line < "$box/answers/$spec"; say "answer $spec: $line"; else say "answer $spec: none"; fi
      ;;
    second=*)
      spec=${argument#second=}
      say "$(python3 "${0%/*}/racer" second "$box" "${spec%%:*}" "${spec#*:}" 2>&1)"
      ;;
    race=*)
      spec=${argument#race=}
      say "$(python3 "${0%/*}/racer" race "$box" "${spec%%:*}" "${spec#*:}" 2>&1)"
      ;;
    slow=*)
      spec=${argument#slow=}
      say "$(python3 "${0%/*}/racer" slow "$box" "${spec%%:*}" "${spec#*:}" 2>&1)"
      ;;
    lease=*)
      spec=${argument#lease=}
      say "$(python3 "${0%/*}/racer" lease "$box" "${spec%%:*}" "${spec#*:}" 2>&1)"
      ;;
    *) say "arg [$argument]" ;;
  esac
done
say "probe $name done"
if [[ -n $term_file ]]; then
  term_checks "$term_file"
  say "probe $name term done"
  tput smcup
  say "full screen"
fi
if [[ -n $typed_file ]]; then
  trap 'printf "%s\n" "interrupted" >> "$typed_file"; exit 0' INT
  while IFS= read -r line; do printf '%s\n' "$line" >> "$typed_file"; done
fi
IFS= read -r _
