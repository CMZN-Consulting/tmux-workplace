#!/usr/bin/env bash
# A stand-in for tmux, named tmux on PATH in t_restart. It runs the tmux named in the file real beside it, and
# where the file lie beside it names a pane, it lists that pane to the carrier's watch as alive with no pipe
# while the pane has one, so the carrier's set meets a pipe that its listing did not show. Each time it does,
# it adds the pane's id as a line to the file told beside it, so a test can show that the lie was told.
here=${BASH_SOURCE[0]%/*}
real=$(< "$here/real")
lie=$(cat -- "$here/lie" 2> /dev/null)
if [[ -n $lie ]]; then
  for word in "$@"; do
    if [[ $word == '#{pane_id} #{pane_pipe}#{pane_dead}' ]]; then
      out=$("$real" "$@")
      rc=$?
      if [[ -n $out ]]; then
        while IFS= read -r line; do
          if [[ $line == "$lie 10" ]]; then
            printf '%s\n' "$lie 00"
            printf '%s\n' "$lie" >> "$here/told"
          else
            printf '%s\n' "$line"
          fi
        done <<< "$out"
      fi
      exit "$rc"
    fi
  done
fi
exec "$real" "$@"
